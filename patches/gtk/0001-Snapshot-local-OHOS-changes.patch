From ca90e86f5111adc5b47c0c7b01c28e30d42365a2 Mon Sep 17 00:00:00 2001
From: Device Exploration <device-exploration@localhost>
Date: Tue, 27 Oct 2026 20:32:06 +0800
Subject: [PATCH 1/3] Snapshot local OHOS changes

---
 gdk/gdkdisplay.c                |  8 +++++++-
 gdk/gdkglcontext.c              |  6 ++++++
 gdk/wayland/gdkkeymap-wayland.c | 10 ++++++++++
 3 files changed, 23 insertions(+), 1 deletion(-)

diff --git a/gdk/gdkdisplay.c b/gdk/gdkdisplay.c
index 2223953..e646067 100644
--- a/gdk/gdkdisplay.c
+++ b/gdk/gdkdisplay.c
@@ -1720,10 +1720,16 @@ gdk_display_create_egl_config (GdkDisplay               *self,
       attrs[i++] = EGL_DONT_CARE;
     }
 
+  if (g_getenv ("WINEHUA_VTEST_PRESENT"))
+    {
+      attrs[i++] = EGL_RENDERABLE_TYPE;
+      attrs[i++] = EGL_OPENGL_BIT;
+    }
+
   attrs[i++] = EGL_NONE;
   g_assert (i < MAX_EGL_ATTRS);
 
-  if (!eglChooseConfig (priv->egl_display, attrs, NULL, -1, &alloced) || alloced == 0)
+  if (!eglChooseConfig (priv->egl_display, attrs, NULL, 0, &alloced) || alloced == 0)
     {
       g_set_error_literal (error, GDK_GL_ERROR, GDK_GL_ERROR_NOT_AVAILABLE,
                            _("No EGL configuration available"));
diff --git a/gdk/gdkglcontext.c b/gdk/gdkglcontext.c
index a779907..f82810d 100644
--- a/gdk/gdkglcontext.c
+++ b/gdk/gdkglcontext.c
@@ -784,6 +784,12 @@ gdk_gl_context_real_end_frame (GdkDrawContext *draw_context,
 
   gdk_draw_context_get_buffer_size (draw_context, &buffer_width, &buffer_height);
 
+  static guint swap_calls = 0;
+  ++swap_calls;
+  if (swap_calls <= 10 || swap_calls % 120 == 0)
+    g_printerr ("GTK_EGL_SWAP call=%u surface=%p egl_surface=%p size=%ux%u\n",
+                swap_calls, surface, priv->egl_surface, buffer_width, buffer_height);
+
   if (priv->eglSwapBuffersWithDamage &&
       cairo_region_contains_rectangle (painted,
                                        &(cairo_rectangle_int_t) {
diff --git a/gdk/wayland/gdkkeymap-wayland.c b/gdk/wayland/gdkkeymap-wayland.c
index 8afa593..39f445e 100644
--- a/gdk/wayland/gdkkeymap-wayland.c
+++ b/gdk/wayland/gdkkeymap-wayland.c
@@ -42,6 +42,7 @@
 #include "gdkkeysprivate.h"
 
 #include <xkbcommon/xkbcommon.h>
+#include "../../../../app/entry/src/main/cpp/input/keymap_xkb.h"
 
 typedef struct _GdkWaylandKeymap          GdkWaylandKeymap;
 typedef struct _GdkWaylandKeymapClass     GdkWaylandKeymapClass;
@@ -529,6 +530,14 @@ _gdk_wayland_keymap_new (GdkDisplay *display)
   names.variant = "";
   names.options = "";
   keymap->xkb_keymap = xkb_keymap_new_from_names (context, &names, 0);
+  g_printerr ("GTK_XKB default map=%p\n", keymap->xkb_keymap);
+  if (!keymap->xkb_keymap)
+    {
+      char *fallback_keymap = g_strndup ((const char *) _tmp_keymap_xkb, sizeof (_tmp_keymap_xkb));
+      keymap->xkb_keymap = xkb_keymap_new_from_string (context, fallback_keymap, 2, 0);
+      g_printerr ("GTK_XKB fallback map=%p\n", keymap->xkb_keymap);
+      g_free (fallback_keymap);
+    }
   keymap->xkb_state = xkb_state_new (keymap->xkb_keymap);
   xkb_context_unref (context);
 
@@ -608,6 +617,7 @@ _gdk_wayland_keymap_update_from_fd (GdkKeymap *keymap,
   GDK_DISPLAY_DEBUG (keymap->display, INPUT, "keymap:\n%s", map_str);
 
   xkb_keymap = xkb_keymap_new_from_string (context, map_str, format, 0);
+  g_printerr ("GTK_XKB compositor map=%p format=%u\n", xkb_keymap, format);
   munmap (map_str, size);
   close (fd);
 
-- 
2.43.0

