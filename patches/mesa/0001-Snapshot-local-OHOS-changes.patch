diff --git a/src/gallium/drivers/zink/zink_kopper.c b/src/gallium/drivers/zink/zink_kopper.c
index 5fa43f4c..ee43d932 100644
--- a/src/gallium/drivers/zink/zink_kopper.c
+++ b/src/gallium/drivers/zink/zink_kopper.c
@@ -30,6 +30,84 @@
 #include "zink_resource.h"
 #include "zink_kopper.h"
 
+#include <dlfcn.h>
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+typedef int (*WinehuaPresentFn)(VkQueue, VkImage, uint32_t, uint32_t, VkFormat,
+                                VkImageLayout, uint32_t, uint32_t, uint32_t, uint64_t *);
+
+static uint32_t
+winehua_surface_id(void)
+{
+   struct page {
+      uint32_t magic;
+      uint32_t version;
+      uint32_t surface_id;
+      uint32_t reserved;
+   };
+   const char *tmp_dir = getenv("TMPDIR");
+   static bool loggedEnv, loggedPage;
+   if (!loggedEnv) {
+      fprintf(stderr, "WineHua surface lookup tmp=%s present=%s\n",
+              tmp_dir ? tmp_dir : "(null)", getenv("WINEHUA_VTEST_PRESENT"));
+      loggedEnv = true;
+   }
+   if (!tmp_dir || !tmp_dir[0] || !getenv("WINEHUA_VTEST_PRESENT"))
+      return 0;
+   char path[256];
+   if (snprintf(path, sizeof(path), "%s/winehua_present_surface_%u.shm",
+                tmp_dir, (uint32_t)getpid()) >= sizeof(path))
+      return 0;
+   int fd = open(path, O_RDONLY | O_CLOEXEC);
+   if (fd < 0) {
+      if (!loggedPage) {
+         fprintf(stderr, "WineHua surface open failed path=%s errno=%d\n", path, errno);
+         loggedPage = true;
+      }
+      return 0;
+   }
+   struct page *page = mmap(NULL, sizeof(*page), PROT_READ, MAP_SHARED, fd, 0);
+   close(fd);
+   if (page == MAP_FAILED)
+      return 0;
+   const uint32_t id = page->magic == 0x57535053u && page->version == 1
+      ? page->surface_id : 0;
+   if (!loggedPage) {
+      fprintf(stderr, "WineHua surface page path=%s magic=%x version=%u id=%u\n",
+              path, page->magic, page->version, id);
+      loggedPage = true;
+   }
+   munmap(page, sizeof(*page));
+   return id;
+}
+
+bool
+zink_winehua_present(struct zink_screen *screen, VkImage image,
+                     uint32_t width, uint32_t height, VkFormat format,
+                     VkImageLayout layout, VkResult *result)
+{
+   const uint32_t surfaceId = winehua_surface_id();
+   if (!surfaceId)
+      return false;
+
+   static uint32_t serial;
+   uint64_t nextDeadline = 0;
+   void *icd = dlopen("libvulkan_virtio.so", RTLD_NOW | RTLD_LOCAL | RTLD_NOLOAD);
+   WinehuaPresentFn present = icd
+      ? (WinehuaPresentFn)dlsym(icd, "vn_winehua_present") : NULL;
+   const int presentResult = present
+      ? present(screen->queue, image, width, height, format, layout,
+                (uint32_t)getpid(), surfaceId, ++serial, &nextDeadline)
+      : -1;
+   if (serial <= 10 || serial % 120 == 0 || presentResult != 0)
+      fprintf(stderr, "WineHua direct present serial=%u result=%d image=%p format=%d layout=%d size=%ux%u\n",
+              serial, presentResult, (void *)image, format, layout, width, height);
+   *result = presentResult == 0 ? VK_SUCCESS : VK_ERROR_DEVICE_LOST;
+   return true;
+}
+
 #define SWAP_BUFFER_COUNT 5
 
