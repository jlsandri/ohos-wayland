@@ -750,6 +828,7 @@ zink_kopper_present(struct zink_screen *screen, struct zink_resource *res)
 static void
 kopper_present(void *data, void *gdata, int thread_idx)
 {
+   fprintf(stderr, "WineHua kopper present entry thread=%d\n", thread_idx);
    struct zink_kopper_present_info *cpi = data;
    struct kopper_displaytarget *cdt = cpi->res->obj->dt;
    struct kopper_swapchain *swapchain = cpi->swapchain;
@@ -787,7 +866,13 @@ kopper_present(void *data, void *gdata, int thread_idx)
       cpi->info.pWaitSemaphores = NULL;
       cpi->info.waitSemaphoreCount = 0;
    }
-   VkResult error2 = VKSCR(QueuePresentKHR)(screen->queue, &cpi->info);
+   VkResult error2;
+   if (!zink_winehua_present(screen, swapchain->images[cpi->image].image,
+                             swapchain->scci.imageExtent.width,
+                             swapchain->scci.imageExtent.height,
+                             swapchain->scci.imageFormat,
+                             VK_IMAGE_LAYOUT_PRESENT_SRC_KHR, &error2))
+      error2 = VKSCR(QueuePresentKHR)(screen->queue, &cpi->info);
    zink_screen_debug_marker_end(screen, screen->frame_marker_emitted);
    zink_screen_debug_marker_begin(screen, "frame");
    simple_mtx_unlock(&screen->queue_lock);
@@ -851,6 +936,7 @@ out:
 void
 zink_kopper_present_queue(struct zink_screen *screen, struct zink_resource *res, unsigned nrects, struct pipe_box *boxes)
 {
+   fprintf(stderr, "WineHua kopper present queue entry\n");
    assert(res->obj->dt);
    struct kopper_displaytarget *cdt = res->obj->dt;
    assert(zink_kopper_acquired(res->obj->dt, res->obj->dt_idx));
