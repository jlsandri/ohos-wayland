+   fprintf(stderr, "WineHua Zink flush front swapchain=%d\n", zink_is_swapchain(res));
+
+   if (!zink_is_swapchain(res)) {
+      VkResult result;
+      pctx->flush(pctx, NULL, PIPE_FLUSH_END_OF_FRAME);
+      simple_mtx_lock(&screen->queue_lock);
+      zink_winehua_present(screen, res->obj->image, res->base.b.width0,
+                           res->base.b.height0, res->format, res->layout, &result);
+      simple_mtx_unlock(&screen->queue_lock);
       return;
+   }
 
    ctx = zink_tc_context_unwrap(pctx);
 
@@ -3305,10 +3313,14 @@ zink_internal_create_screen(const struct pipe_screen_config *config, int64_t dev
 
    u_trace_state_init();
 
-   screen->loader_lib = util_dl_open(VK_LIBNAME);
+   /* OHOS WSI lives in the system loader's VK_LAYER_OHOS_surface, so the
+    * direct path must be able to pick the system loader over the bundled one.
+    */
+   const char *vk_libname = debug_get_option("ZINK_VULKAN_LIBRARY", VK_LIBNAME);
+   screen->loader_lib = util_dl_open(vk_libname);
    if (!screen->loader_lib) {
       if (!screen->driver_name_is_inferred)
-         mesa_loge("ZINK: failed to load "VK_LIBNAME);
+         mesa_loge("ZINK: failed to load %s", vk_libname);
       goto fail;
    }
 
