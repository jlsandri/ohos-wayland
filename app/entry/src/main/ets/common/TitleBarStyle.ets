// GTK title bars drawn like the ArkUI window decor (container_modal in
// arkui_ace_engine, measured on the device with uitest dumpLayout): a 37vp
// bar, the app icon 20vp from the left, then the title, and maximize,
// minimize, close as 28vp circles with 20vp glyphs, 12vp apart and 20vp
// from the right edge. Colours follow ContainerModalTheme::GetControlBtnColor.

interface DecorPalette {
  bar: string;
  barBackdrop: string;
  title: string;
  titleBackdrop: string;
  button: string;
  buttonHover: string;
  buttonPress: string;
  buttonBackdrop: string;
  hover: string;
  glyph: string;
  glyphBackdrop: string;
  close: string;
  closeGlyph: string;
  closeHover: string;
  closeHoverGlyph: string;
  closePress: string;
  closeBackdrop: string;
  closeGlyphBackdrop: string;
}

// The focused dark bar is #333333 on the device; the light bar uses the
// HarmonyOS light window background.
const DARK: DecorPalette = {
  bar: '#333333',
  barBackdrop: '#262626',
  title: 'rgba(255,255,255,0.9)',
  titleBackdrop: 'rgba(255,255,255,0.4)',
  button: 'rgba(255,255,255,0.2)',
  buttonHover: 'rgba(255,255,255,0.28)',
  buttonPress: 'rgba(255,255,255,0.32)',
  buttonBackdrop: 'rgba(255,255,255,0.08)',
  hover: 'rgba(255,255,255,0.1)',
  glyph: '#ffffff',
  glyphBackdrop: 'rgba(255,255,255,0.4)',
  close: 'rgba(230,165,165,0.3)',
  closeGlyph: '#d94838',
  closeHover: '#d94838',
  closeHoverGlyph: '#e5e5e5',
  closePress: '#de6355',
  closeBackdrop: 'rgba(230,165,165,0.12)',
  closeGlyphBackdrop: 'rgba(217,72,56,0.4)',
};

const LIGHT: DecorPalette = {
  bar: '#f1f3f5',
  barBackdrop: '#f5f5f5',
  title: 'rgba(0,0,0,0.9)',
  titleBackdrop: 'rgba(0,0,0,0.4)',
  button: 'rgba(0,0,0,0.1)',
  buttonHover: 'rgba(0,0,0,0.14)',
  buttonPress: 'rgba(0,0,0,0.19)',
  buttonBackdrop: 'rgba(0,0,0,0.04)',
  hover: 'rgba(0,0,0,0.05)',
  glyph: '#000000',
  glyphBackdrop: 'rgba(0,0,0,0.4)',
  close: 'rgba(232,64,38,0.1)',
  closeGlyph: '#e84026',
  closeHover: '#e84026',
  closeHoverGlyph: '#ffffff',
  closePress: '#d03922',
  closeBackdrop: 'rgba(232,64,38,0.04)',
  closeGlyphBackdrop: 'rgba(232,64,38,0.4)',
};

// Buttons in any app chrome that are not window controls stay flat glyphs.
const PLAIN = ':not(.suggested-action):not(.destructive-action):not(.raised)';

// vpToPx: GTK logical pixels per vp (the density over the output scale).
export function titleBarCss(dark: boolean, vpToPx: number): string {
  const c = dark ? DARK : LIGHT;
  const vp = (value: number): string => `${(value * vpToPx).toFixed(2)}px`;
  // Matching the button selectors' weight keeps the capsule rules out.
  const control = `windowcontrols > button${PLAIN}`;
  return `
/* Title bar: generated by the launcher (TitleBarStyle.ets). */
:root {
  --headerbar-bg-color: ${c.bar};
  --headerbar-backdrop-color: ${c.barBackdrop};
  --headerbar-fg-color: ${c.title};
  --headerbar-shade-color: transparent;
  --headerbar-darker-shade-color: transparent;
}
/* The HarmonyOS window rounds and clips the corners (Index.ets). */
window.csd, window.solid-csd, window.background.csd { border-radius: 0; }
headerbar, .titlebar, tabbar.titlebar, toolbarview > .top-bar headerbar {
  background: ${c.bar};
  color: ${c.title};
  min-height: ${vp(37)};
  padding: 0 ${vp(20)};
  box-shadow: none;
  border: none;
}
headerbar:backdrop, .titlebar:backdrop { background: ${c.barBackdrop}; color: ${c.titleBackdrop}; }
headerbar .title, windowtitle .title, .titlebar .title { font-size: ${vp(14)}; font-weight: 500; }
headerbar windowhandle > box, headerbar > windowhandle > box { padding: 0; }
windowcontrols { border-spacing: ${vp(12)}; margin: 0; padding: 0; }
windowcontrols.start { margin-right: ${vp(12)}; }
windowcontrols.end { margin-left: ${vp(12)}; }
windowcontrols > .icon { -gtk-icon-size: ${vp(20)}; min-width: ${vp(20)}; min-height: ${vp(20)}; padding: 0; margin: 0; }
${control}, ${control}.flat {
  min-width: ${vp(28)};
  min-height: ${vp(28)};
  padding: 0;
  margin: ${vp(4.5)} 0;
  border-radius: 9999px;
  border: none;
  box-shadow: none;
  outline: none;
  background: ${c.button};
  color: ${c.glyph};
}
${control} > image { -gtk-icon-size: ${vp(20)}; background: none; box-shadow: none; padding: 0; margin: 0; }
${control}:hover { background: ${c.buttonHover}; }
${control}:active { background: ${c.buttonPress}; }
${control}:backdrop { background: ${c.buttonBackdrop}; color: ${c.glyphBackdrop}; }
${control}.close { background: ${c.close}; color: ${c.closeGlyph}; }
${control}.close:hover { background: ${c.closeHover}; color: ${c.closeHoverGlyph}; }
${control}.close:active { background: ${c.closePress}; color: ${c.closeHoverGlyph}; }
${control}.close:backdrop { background: ${c.closeBackdrop}; color: ${c.closeGlyphBackdrop}; }

/* Other buttons in the chrome: flat glyphs with the HarmonyOS hover. */
headerbar button${PLAIN}:not(.close):not(.maximize):not(.minimize),
tabbar button${PLAIN},
.titlebar button${PLAIN}:not(.close):not(.maximize):not(.minimize) {
  background: transparent;
  box-shadow: none;
  border: none;
  outline: none;
  min-height: ${vp(28)};
  padding-top: 0;
  padding-bottom: 0;
  margin-top: ${vp(4.5)};
  margin-bottom: ${vp(4.5)};
}
headerbar button${PLAIN}:not(.close):not(.maximize):not(.minimize):hover,
tabbar button${PLAIN}:hover,
.titlebar button${PLAIN}:not(.close):not(.maximize):not(.minimize):hover { background: ${c.hover}; }
headerbar stackswitcher > button${PLAIN}:checked { background: ${c.button}; }
`;
}
