// The symbol for an icon name, with or without its -symbolic suffix.
export function symbolFor(icon?: string): Resource | undefined {
  if (!icon) return undefined;
  return SYMBOLS[icon.replace(/-symbolic(-rtl|-ltr)?$/, '')];
}
